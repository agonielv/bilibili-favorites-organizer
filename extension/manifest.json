{
  "manifest_version": 3,
  "name": "Bilibili 收藏夹整理",
  "version": "1.3.3",
  "description": "在独立管理页选择收藏夹，按可配置规则预览和整理，保留限流保护。",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": ["storage", "cookies", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["https://api.bilibili.com/*", "https://www.bilibili.com/*", "https://space.bilibili.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_title": "打开收藏夹整理"},
  "content_scripts": [{"matches": ["https://space.bilibili.com/*"], "js": ["content-entry.js"], "run_at": "document_idle"}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"},
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}
}
